#: .\sing\templates\sing\song.html:6

msgid "Song Lyric"
msgstr "Paroles de chanson"

msgid "Щедрик"
msgstr "Schedryk"

msgid "Щедрик, щедрик, щедрівочка,"
msgstr "Schedryk, schedryk, petite hirondelle,"

msgid "Прилетіла ластівочка,"
msgstr "Une hirondelle est arrivée,"

msgid "Стала собі щебетати,"
msgstr "Elle a commencé à gazouiller,"

msgid "Господаря викликати:"
msgstr "Appelant le maître:"

msgid "Вийди, вийди, господарю,"
msgstr "Sors, sors, maître,"

msgid "Подивися на кошару,"
msgstr "Regarde ton enclos,"

msgid "Там овечки покотились,"
msgstr "Là les brebis ont agnelé,"

msgid "А ягнички народились,"
msgstr "Et les agneaux sont nés,"

msgid "В тебе товар весь хороший,"
msgstr "Tes biens sont tous bons,"

msgid "Будеш мати мірку грошей,"
msgstr "Tu auras une mesure d'argent,"

msgid "Хоч не гроші, то полова —"
msgstr "Sinon de l'argent, alors de la paille —"

msgid "В тебе жінка чорноброва."
msgstr "Tu as une femme aux sourcils noirs."

msgid "Прилетіла ластівочка."
msgstr "Une hirondelle est arrivée."

