msgid "Song Lyric"
msgstr "Liedtext"

msgid "Щедрик"
msgstr "Schedryk"

msgid "Щедрик, щедрик, щедрівочка,"
msgstr "Schedryk, Schedryk, kleine Schwalbe,"

msgid "Прилетіла ластівочка,"
msgstr "Eine Schwalbe ist geflogen,"

msgid "Стала собі щебетати,"
msgstr "Begann zu zwitschern,"

msgid "Господаря викликати:"
msgstr "Ruft den Hausherrn:"

msgid "Вийди, вийди, господарю,"
msgstr "Komm heraus, komm heraus, Hausherr,"

msgid "Подивися на кошару,"
msgstr "Sieh dir deinen Schafstall an,"

msgid "Там овечки покотились,"
msgstr "Dort haben die Schafe gelammt,"

msgid "А ягнички народились,"
msgstr "Und die Lämmer sind geboren,"

msgid "В тебе товар весь хороший,"
msgstr "Deine Waren sind alle gut,"

msgid "Будеш мати мірку грошей,"
msgstr "Du wirst ein Maß Geld haben,"

msgid "Хоч не гроші, то полова —"
msgstr "Wenn nicht Geld, dann Spreu —"

msgid "В тебе жінка чорноброва."
msgstr "Du hast eine dunkelbrauige Frau."

msgid "Прилетіла ластівочка."
msgstr "Eine Schwalbe ist geflogen."

