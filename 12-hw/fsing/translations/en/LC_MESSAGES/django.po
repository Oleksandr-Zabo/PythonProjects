msgid "Song Lyric"
msgstr "Song Lyric"

msgid "Щедрик"
msgstr "Schedryk"

msgid "Щедрик, щедрик, щедрівочка,"
msgstr "Schedryk, schedryk, little swallow,"

msgid "Прилетіла ластівочка,"
msgstr "A swallow has flown in,"

msgid "Стала собі щебетати,"
msgstr "Started to chirp,"

msgid "Господаря викликати:"
msgstr "Calling the master:"

msgid "Вийди, вийди, господарю,"
msgstr "Come out, come out, master,"

msgid "Подивися на кошару,"
msgstr "Look at your sheepfold,"

msgid "Там овечки покотились,"
msgstr "There the ewes have lambed,"

msgid "А ягнички народились,"
msgstr "And the lambs are born,"

msgid "В тебе товар весь хороший,"
msgstr "All your goods are fine,"

msgid "Будеш мати мірку грошей,"
msgstr "You will have a measure of money,"

msgid "Хоч не гроші, то полова —"
msgstr "If not money, then chaff —"

msgid "В тебе жінка чорноброва."
msgstr "You have a dark-browed wife."

msgid "Прилетіла ластівочка."
msgstr "A swallow has flown in."
