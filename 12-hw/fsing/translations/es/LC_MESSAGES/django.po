#: .\sing\templates\sing\song.html:6
msgid "Song Lyric"
msgstr "Letra de canción"

msgid "Щедрик"
msgstr "Schedryk"

msgid "Щедрик, щедрик, щедрівочка,"
msgstr "Schedryk, schedryk, pequeña golondrina,"

msgid "Прилетіла ластівочка,"
msgstr "Una golondrina ha llegado,"

msgid "Стала собі щебетати,"
msgstr "Comenzó a gorjear,"

msgid "Господаря викликати:"
msgstr "Llamando al dueño:"

msgid "Вийди, вийди, господарю,"
msgstr "Sal, sal, dueño,"

msgid "Подивися на кошару,"
msgstr "Mira tu redil,"

msgid "Там овечки покотились,"
msgstr "Allí las ovejas han parido,"

msgid "А ягнички народились,"
msgstr "Y los corderos han nacido,"

msgid "В тебе товар весь хороший,"
msgstr "Tus bienes son todos buenos,"

msgid "Будеш мати мірку грошей,"
msgstr "Tendrás una medida de dinero,"

msgid "Хоч не гроші, то полова —"
msgstr "Si no dinero, entonces paja —"

msgid "В тебе жінка чорноброва."
msgstr "Tienes una esposa de cejas negras."

msgid "Прилетіла ластівочка."
msgstr "Una golondrina ha llegado."

